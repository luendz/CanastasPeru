# Supabase (Project Settings → API). Copia este archivo como .env.local y completa.
# La publishable key es pública por diseño; la seguridad la dan las políticas RLS.
# Nunca pongas aquí la service_role key ni la contraseña de la base.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Solo servidor: secretos. En producción van como secrets del Worker
# (`npx wrangler secret put NOMBRE`), nunca en el código ni con NEXT_PUBLIC_.
# Secret key de Supabase (Project Settings → API Keys → Secret keys). Solo la usa
# el webhook de Mercado Pago para marcar órdenes como pagadas.
SUPABASE_SECRET_KEY=
# Mercado Pago (Tus integraciones → tu aplicación). Usa primero las credenciales de prueba.
MP_ACCESS_TOKEN=
# Clave secreta de las notificaciones (Webhooks → Configurar notificaciones).
MP_WEBHOOK_SECRET=
# 1 mientras uses credenciales de prueba: no se envía el correo del cliente a
# Mercado Pago (un correo real con un vendedor de prueba hace fallar el pago).
# Quítala al pasar a credenciales de producción.
MP_MODO_PRUEBA=1
# URL pública del sitio, sin / final (opcional; si falta se usa la del pedido).
SITIO_URL=
